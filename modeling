from __future__ import annotations
import math
from dataclasses import dataclass
from typing import Optional
import keras
from keras import layers
from keras import ops
from .operators import (
    decayed_cummax_step,
    evidence_pooling,
    evidence_weights,
    head_averaged_attention,
    self_attention_score,
)

class TraceConfig:
    d_model: int = 128
    n_blocks: int = 5
    n_heads: int = 8
    ffn_hidden: int = 512
    dropout: float = 0.1
    gamma: float = 0.6
    n_classes: int = 2
    persistence: bool = True
    output_scaling: bool = True
    pooling: str = "evidence"
    backbone: str = "bert-base-uncased"
    freeze_backbone: bool = False
    bert_hidden: int = 768


class TraceAttention(layers.Layer):
    def __init__(self, d_model: int, n_heads: int, dropout: float, **kwargs) -> None:
        super().__init__(**kwargs)
        self.n_heads = n_heads
        self.d_head = d_model // n_heads
        self.scale = 1.0 / math.sqrt(self.d_head)
        
        self.w_q = layers.Dense(d_model)
        self.w_k = layers.Dense(d_model)
        self.w_v = layers.Dense(d_model)
        self.w_o = layers.Dense(d_model)
        self.drop = layers.Dropout(dropout)

    def _split(self, x) -> ops.Tensor:
        b, t = ops.shape(x)[0], ops.shape(x)[1]
        x = ops.reshape(x, (b, t, self.n_heads, self.d_head))
        return ops.transpose(x, (0, 2, 1, 3))

    def call(self, x, padding_mask, training=False):
        q, k, v = self._split(self.w_q(x)), self._split(self.w_k(x)), self._split(self.w_v(x))
        scores = ops.matmul(q, ops.transpose(k, (0, 1, 3, 2))) * self.scale
        
        expanded_mask = ops.expand_dims(ops.expand_dims(padding_mask, 1), 1)
        scores = ops.where(expanded_mask, -1e9, scores)
        
        attn = ops.softmax(scores, axis=-1)
        out = ops.matmul(self.drop(attn, training=training), v)
        
        out = ops.transpose(out, (0, 2, 1, 3))
        b, t = ops.shape(x)[0], ops.shape(x)[1]
        out = self.w_o(ops.reshape(out, (b, t, -1)))
        
        sas = self_attention_score(head_averaged_attention(attn))
        return out, sas


class TraceBlock(layers.Layer):
    def __init__(self, cfg: TraceConfig, **kwargs) -> None:
        super().__init__(**kwargs)
        self.cfg = cfg
        self.ln_attn = layers.LayerNormalization(epsilon=1e-5)
        self.attn = TraceAttention(cfg.d_model, cfg.n_heads, cfg.dropout)
        self.ln_ffn = layers.LayerNormalization(epsilon=1e-5)
        self.ffn = keras.Sequential([
            layers.Dense(cfg.ffn_hidden, activation="gelu"),
            layers.Dense(cfg.ffn_hidden, activation="gelu"),
            layers.Dense(cfg.d_model)
        ])
        self.drop = layers.Dropout(cfg.dropout)

    def call(self, x, accumulated, padding_mask, training=False):
        attn_out, sas = self.attn(self.ln_attn(x), padding_mask, training=training)
        
        accumulated = decayed_cummax_step(accumulated, sas, self.cfg.gamma) if self.cfg.persistence else sas
        if self.cfg.output_scaling:
            attn_out = attn_out * ops.expand_dims(accumulated, -1)
            
        x = x + self.drop(attn_out, training=training)
        x = x + self.drop(self.ffn(self.ln_ffn(x)), training=training)
        return x, accumulated, sas


class TraceModel(keras.Model):
    def __init__(self, cfg: TraceConfig, **kwargs) -> None:
        super().__init__(**kwargs)
        self.cfg = cfg
        
        from transformers import TFAutoModel, AutoModel
        self.bert = AutoModel.from_pretrained(cfg.backbone) if keras.backend.backend() == "torch" else TFAutoModel.from_pretrained(cfg.backbone)
        if cfg.freeze_backbone:
            self.bert.trainable = False
            
        self.proj = layers.Dense(cfg.d_model)
        self.proj_ln = layers.LayerNormalization(epsilon=1e-5)
        self.blocks = [TraceBlock(cfg) for _ in range(cfg.n_blocks)]
        self.final_ln = layers.LayerNormalization(epsilon=1e-5)
        self.classifier = layers.Dense(cfg.n_classes)
        
        if cfg.pooling == "attention":
            self.attn_pool = layers.Dense(1)

    def _pool(self, hidden, accumulated, padding_mask):
        weights = evidence_weights(accumulated, padding_mask)
        if self.cfg.pooling == "evidence":
            return evidence_pooling(hidden, weights), weights
        if self.cfg.pooling == "cls":
            return hidden[:, 0, :], weights
        if self.cfg.pooling == "mean":
            keep = ops.cast(ops.logical_not(padding_mask), "float32")
            pooled = ops.sum(hidden * ops.expand_dims(keep, -1), axis=1) / ops.maximum(
                ops.sum(keep, axis=1, keepdims=True), 1.0
            )
            return pooled, weights
            
        logits = ops.squeeze(self.attn_pool(hidden), axis=-1)
        logits = ops.where(padding_mask, -1e9, logits)
        alpha = ops.softmax(logits, axis=-1)
        return ops.einsum("bt,btd->bd", alpha, hidden), weights

    def call(self, inputs, training=False):
        input_ids = inputs.get("input_ids")
        attention_mask = inputs.get("attention_mask")
        token_type_ids = inputs.get("token_type_ids", None)
        
        padding_mask = ops.equal(attention_mask, 0)
        bert_kwargs = {"input_ids": input_ids, "attention_mask": attention_mask}
        if token_type_ids is not None:
            bert_kwargs["token_type_ids"] = token_type_ids
            
        hidden = self.bert(**bert_kwargs).last_hidden_state
        x = self.proj_ln(self.proj(hidden))
        
        b, t = ops.shape(x)[0], ops.shape(x)[1]
        accumulated = ops.zeros((b, t), dtype=x.dtype)
        
        sas_trace = []
        for block in self.blocks:
            x, accumulated, sas = block(x, accumulated, padding_mask, training=training)
            sas_trace.append(sas)
            
        x = self.final_ln(x)
        accumulated = ops.where(padding_mask, 0.0, accumulated)
        pooled, weights = self._pool(x, accumulated, padding_mask)
        
        return {
            "logits": self.classifier(pooled),
            "weights": weights,
            "accumulated": accumulated,
            "sas_trace": ops.stack(sas_trace, axis=1),
        }

